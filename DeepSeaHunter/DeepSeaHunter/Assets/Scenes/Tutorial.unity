--- !u!114 &5909474189718560796
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 709889438590716107}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a688ceb77ec1554a9c1805812809e50, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Doc Maher
  lines:
  - speakerName: 'Player:'
    line: "The sign above the door reads Maher\u2019s Clinic, its paint peeling like
      old skin. A bell gave a tired chime as I stepped inside. The man behind the
      counter stood tall and still\u2014long white hair, thin spectacles balanced
      on a hawkish nose, and eyes like storm clouds caught in glass. The sharp tang
      of antiseptic clung to the air like a warning."
    choices: []
  - speakerName: 'Player:'
    line: "The sign above the door reads Maher\u2019s Clinic, its paint peeling like
      old skin. A bell gave a tired chime as I stepped inside. The man behind the
      counter stood tall and still\u2014long white hair, thin spectacles balanced
      on a hawkish nose, and eyes like storm clouds caught in glass. The sharp tang
      of antiseptic clung to the air like a warning."
    choices: []
  - speakerName: 'Player:'
    line: "\u201CDoc, you ever hear Nathan mention where he dives? I can\u2019t find
      him.\u201D"
    choices: []
  - speakerName: 'Doc Maher:'
    line: "\u201COnly that he was exhausted. Came in twice last month with burst
      vessels in his eyes and mild nitrogen narcosis symptoms. Told me, \u2018I\u2019m
      so close, doc.\u2019 I tried to warn him to stop. He just laughed, said, 'The
      sea won\u2019t keep her secrets forever.' That\u2019s all I know. Though I
      don\u2019t like it. Don't be like him and wait till things are bad to come
      in, take care of yourself before things become a bigger problem.\u201D"
    choices: []
  - speakerName: 'Player:'
    line: Thanks, I'll come see ya, if i find myself feeling green at the gills."
    choices: []
