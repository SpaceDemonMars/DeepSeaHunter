--- !u!114 &855396720156724546
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5766394303391344021}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a688ceb77ec1554a9c1805812809e50, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Jewel
  lines:
  - speakerName: 'Player:'
    line: "The mechanic\u2019s coveralls were deep blue, pocked with grease, coolant,
      and wear.  A patch stitched over her chest read Jewel, and her wild red hair
      escaped in fiery wisps from beneath a smudged cap. If it weren\u2019t for the
      oil smears mixing with her freckles, she might\u2019ve looked like a poster
      girl for island charm\u2014but she wore grit like a second skin."
    choices: []
  - speakerName: 'Player:'
    line: "The mechanic\u2019s coveralls were deep blue, pocked with grease, coolant,
      and wear.  A patch stitched over her chest read Jewel, and her wild red hair
      escaped in fiery wisps from beneath a smudged cap. If it weren\u2019t for the
      oil smears mixing with her freckles, she might\u2019ve looked like a poster
      girl for island charm\u2014but she wore grit like a second skin."
    choices: []
  - speakerName: 'Player:'
    line: "\u201CYou\u2019ve worked on Nathan\u2019s gear, right? Know where he might\u2019ve
      gone diving?\u201D"
    choices: []
  - speakerName: 'Jewel:'
    line: "\u201CHeh, Nate? Yeah, I patched up his tanks and pressure gauge just
      last week. Kept askin\u2019 me if I could \u2018seal something for deep pressure\u2019\u2014deeper
      than I\u2019d recommend for a solo dive. Didn\u2019t say where he was goin\u2019.
      Just said, \u2018If it holds, I\u2019ll owe you a story.\u2019 I never liked
      that kind of talk.\u201D"
    choices: []
  - speakerName: 'Player:'
    line: '"Thanks anyway."'
    choices: []
