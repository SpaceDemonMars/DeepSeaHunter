    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
    requiresItem: 0
    requiredItemName: 
    requiredItemAmount: 0
    requiresQuest: 0
    requiredQuestID: 0
    questMustBeCompleted: 0
  - speakerName: 'Jim:'
    line: '"Good o''le Alan always pays his debts, let him know he''s all good in
      my book."'
    choices: []
    completeQuest: 1
    questToComplete: 4
    startQuest: 0
    questToStart: 0
    requiresItem: 0
    requiredItemName: 
    requiredItemAmount: 0
    requiresQuest: 0
    requiredQuestID: 0
    questMustBeCompleted: 0
  - speakerName: 'Player:'
    line: '"Sure thing, I''ll let him know. See you later Jim."'
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 1
    questToStart: 6
    requiresItem: 0
    requiredItemName: 
    requiredItemAmount: 0
    requiresQuest: 0
    requiredQuestID: 0
    questMustBeCompleted: 0
  - speakerName: 'Jim:'
    line: '"Well if ya ever have any other tasty treats to offload, bring ''em here,
      and I''ll give you something tasty that will tide you over on those long trips
      ta sea."'
