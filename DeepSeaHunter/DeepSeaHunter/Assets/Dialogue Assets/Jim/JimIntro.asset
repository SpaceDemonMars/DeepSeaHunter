  npcName: Jim
  lines:
  - speakerName: ???
    line: "\"You\u2019re not from around here, are ya? Folks don\u2019t come to Blacktide
      unless they\u2019re runnin\u2019 from somethin\u2019... or lookin\u2019 for
      somethin\u2019. You seem like the latter. Name\u2019s Jim\u2014what can I do
      for ya?\" "
