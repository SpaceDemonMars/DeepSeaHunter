  - speakerName: 'Player:'
    line: "\u201CI'm looking for my friend Nathan, do ya know where i can find him?\u201D"
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
    requiresItem: 0
    requiredItemName: 
    requiredItemAmount: 0
    attemptTurnIn: 0
    changeSceneAfter: 0
