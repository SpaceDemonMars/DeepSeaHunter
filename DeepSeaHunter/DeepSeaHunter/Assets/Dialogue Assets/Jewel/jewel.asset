  - speakerName: 'Player:'
    line: "\u201CYou\u2019ve worked on Nathan\u2019s gear, right? Know where he might\u2019ve
      gone diving?\u201D"
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
    requiresItem: 0
    requiredItemName: 
    requiredItemAmount: 0
    requiresQuest: 0
    requiredQuestID: 0
    questMustBeCompleted: 0
  - speakerName: 'Jewel:'
    line: "\u201CHeh, Nate? Yeah, I patched up his tanks and pressure gauge just
      last week. Kept askin\u2019 me if I could \u2018seal something for deep pressure\u2019\u2014deeper
      than I\u2019d recommend for a solo dive. Didn\u2019t say where he was goin\u2019.
      Just said, \u2018If it holds, I\u2019ll owe you a story.\u2019 I never liked
      that kind of talk.\u201D"
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
    requiresItem: 0
    requiredItemName: 
    requiredItemAmount: 0
    requiresQuest: 0
    requiredQuestID: 0
    questMustBeCompleted: 0
  - speakerName: 'Player:'
    line: '"Thanks anyway."'
