    questMustBeCompleted: 0
  - speakerName: 'Jewel:'
    line: ": \"Got an old set collectin\u2019 rust back there\u2014nothing fancy.
      Seals ain\u2019t great, gauges are twitchy, and she smells like brine and regret.
      But she should be good for a short dive or two...\u201D"
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
    requiresItem: 0
    requiredItemName: 
    requiredItemAmount: 0
    requiresQuest: 0
    requiredQuestID: 0
    questMustBeCompleted: 0
  - speakerName: 'Player:'
    line: "\"I\u2019ll take it. How much?\""
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
    requiresItem: 0
    requiredItemName: 
