  npcName: Jewel
  lines:
  - speakerName: 'Player:'
    line: " \"Hey, Jewel\u2014you wouldn\u2019t happen to have any spare dive gear
      lying around, would you?\""
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
    requiresItem: 0
    requiredItemName: 
    requiredItemAmount: 0
    requiresQuest: 0
