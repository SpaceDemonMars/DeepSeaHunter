  m_Script: {fileID: 11500000, guid: 1a688ceb77ec1554a9c1805812809e50, type: 3}
  m_Name: AlanIntro
  m_EditorClassIdentifier: 
  npcName: Alan
  lines:
  - speakerName: 'Player:'
    line: "The man looked like your typical whaler\u2014sun-bleached clothes, salt-stained
      boots, and a smell that could gut a seagull at ten paces. His face held scars
      that surely had tales to tell. One of them, a jagged cut of skin, split his
      cheek like a lightning bolt frozen in flesh, and the rest of his face looked
      carved from wind and grit."
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
  - speakerName: 'Player:'
    line: "The man looked like your typical whaler\u2014sun-bleached clothes, salt-stained
      boots, and a smell that could gut a seagull at ten paces. His face held scars
      that surely had tales to tell. One of them, a jagged cut of skin, split his
      cheek like a lightning bolt frozen in flesh, and the rest of his face looked
      carved from wind and grit."
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
  - speakerName: 'Player:'
    line: "\u201CI\u2019m looking for my friend Nathan, wouldn\u2019t happen to know
      where he is, do you?\""
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
  - speakerName: 'Alan:'
    line: "\u201CAh, Nathan? Yeah, I know him. Bit squirrelly\u2014always jabberin\u2019
      about old ruins like he was about to discover Atlantis with a pocket compass
      and a half-eaten sandwich. I seen him go out a few times. Real determined.
      Real twitchy. The name's Alan, can't say I've seen him today though.\""
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
  - speakerName: 'Player:'
    line: '"Alright, I''ll see you around then."'
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
