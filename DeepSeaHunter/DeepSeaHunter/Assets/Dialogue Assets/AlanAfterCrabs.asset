    startQuest: 0
    questToStart: 0
  - speakerName: 'Player:'
    line: "\"I\u2019ve delivered the crabs to Jim, so can you take me out now?\""
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
  - speakerName: 'Alan:'
    line: "\"I could... but unless you\u2019re plannin\u2019 to dive blind and hold
      your breath the whole way, you\u2019re not ready. Best swing by Jewel\u2019s\u2014see
      if she\u2019s got some gear to get you under.\""
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 1
    questToStart: 7
  - speakerName: 'Player:'
    line: "\"Right... guess I\u2019ll be back.\""
