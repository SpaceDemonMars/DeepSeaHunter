  - speakerName: 'Player:'
    line: "\u201CYou wouldn\u2019t happen to know where Nathan dives, would you?\u201D"
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
    requiresItem: 0
