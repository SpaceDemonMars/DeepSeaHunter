    questMustBeCompleted: 0
    changeSceneAfter: 0
    sceneToLoad: 
  - speakerName: 'Player:'
    line: "\u201CDoc, you ever hear Nathan mention where he dives? I can\u2019t find
      him.\u201D"
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
    requiresItem: 0
    requiredItemName: 
    requiredItemAmount: 0
    requiresQuest: 0
    requiredQuestID: 0
    questMustBeCompleted: 0
    changeSceneAfter: 0
    sceneToLoad: 
  - speakerName: 'Doc Maher:'
    line: "\u201COnly that he was exhausted. Came in twice last month with burst
      vessels in his eyes and mild nitrogen narcosis symptoms. Told me, \u2018I\u2019m
      so close, doc.\u2019 I tried to warn him to stop. He just laughed, said, \"The
      sea won\u2019t keep her secrets forever.\" That\u2019s all I know. Though I
      don\u2019t like it.\u201D"
    choices: []
    completeQuest: 0
    questToComplete: 0
    startQuest: 0
    questToStart: 0
    requiresItem: 0
    requiredItemName: 
    requiredItemAmount: 0
    requiresQuest: 0
    requiredQuestID: 0
    questMustBeCompleted: 0
    changeSceneAfter: 0
    sceneToLoad: 
  - speakerName: 'Player:'
    line: '"Be seeing you Doc."'
